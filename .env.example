PORT=3000
HOST=0.0.0.0
NODE_ENV=development
TRUST_PROXY=false
DATABASE_FILE=./data/orders.sqlite
ADMIN_USERNAME=admin
# Use a long, unique password before exposing the server.
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters
CONFIG_ENCRYPTION_KEY=replace-with-64-hex-characters
PUBLIC_BASE_URL=https://your-domain.example
MOCK_PAYMENT=true
# Set MOCK_PAYMENT=false and complete all fields below for real WeChat Pay.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MCH_ID=
WECHAT_MCH_SERIAL_NO=
WECHAT_MCH_PRIVATE_KEY_PATH=
WECHAT_PLATFORM_CERT_PATH=
WECHAT_PLATFORM_SERIAL_NO=
WECHAT_API_V3_KEY=
# Optional printer webhook compatible with your cloud printer adapter.
PRINTER_WEBHOOK_URL=
PRINTER_WEBHOOK_TOKEN=
