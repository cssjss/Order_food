.favorites-title {
  font-size: 40rpx;
  font-weight: 700;
  margin: 12rpx 0 30rpx;
}
.favorite-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 17rpx;
  position: relative;
}
.favorite-card__image {
  width: 140rpx;
  height: 140rpx;
  flex: none;
  border-radius: 13rpx;
  background: #eae8dc;
  display: grid;
  place-items: center;
  color: #d8c4aa;
  font-size: 40rpx;
  overflow: hidden;
}
.favorite-card__image image {
  width: 100%;
  height: 100%;
}
.favorite-card__body {
  flex: 1;
  min-width: 0;
}
.favorite-card__body text {
  display: block;
}
.favorite-card__body text:first-child {
  font-size: 27rpx;
  font-weight: 700;
}
.favorite-card__body text:nth-child(2) {
  font-size: 21rpx;
  color: #a0aba0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin: 7rpx 0 13rpx;
}
.favorite-card__remove {
  color: #78b93b;
  align-self: flex-start;
  font-size: 30rpx;
}
