<view class="page favorites-page"><view class="favorites-title">我的收藏</view><view wx:if="{{!items.length && !loading}}" class="empty"><text class="empty-icon">♡</text><text>还没有收藏喜欢的菜品</text></view><view wx:for="{{items}}" wx:key="id" class="favorite-card card"><view class="favorite-card__image" data-id="{{item.id}}" bindtap="open"><image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill"/><text wx:else>✦</text></view><view class="favorite-card__body" data-id="{{item.id}}" bindtap="open"><text>{{item.name}}</text><text>{{item.description}}</text><text class="price">{{item.priceText}}</text></view><text class="favorite-card__remove" data-id="{{item.id}}" bindtap="remove">♥</text></view></view>
