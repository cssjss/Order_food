<view class="menu-page" style="--menu-accent:{{page.accent || '#78b93b'}}">
  <view class="menu-head">
    <text class="menu-head__eyebrow">现点现做 · 到店自取</text>
    <text class="menu-head__title">想吃什么？</text>
    <text class="menu-head__subtitle">按分类挑选，喜欢的味道都在这里</text>
  </view>

  <view class="menu-search">
    <text class="menu-search__icon">⌕</text>
    <input placeholder="搜索想吃的菜品" value="{{query}}" bindinput="search" bindfocus="focus" bindconfirm="submitSearch" confirm-type="search" />
    <text wx:if="{{query}}" class="menu-search__submit" bindtap="submitSearch">搜索</text>
  </view>
  <view wx:if="{{searchOpen && history.length}}" class="menu-history">
    <view class="menu-history__head"><text>历史搜索</text><text bindtap="clearHistory">清空</text></view>
    <view class="menu-history__words">
      <text wx:for="{{history}}" wx:key="*this" data-word="{{item}}" bindtap="historySearch">{{item}}</text>
    </view>
  </view>

  <view class="menu-section-head">
    <text>全部菜品</text>
    <text>{{visible.length}} 道</text>
  </view>
  <view class="menu-layout">
    <scroll-view scroll-y class="menu-categories">
      <view class="menu-category {{activeCategory === 0 ? 'menu-category--active' : ''}}" data-id="0" bindtap="category">全部</view>
      <view wx:for="{{categories}}" wx:key="id" class="menu-category {{activeCategory === item.id ? 'menu-category--active' : ''}}" data-id="{{item.id}}" bindtap="category">{{item.name}}</view>
    </scroll-view>

    <view class="menu-dishes">
      <view wx:if="{{loading}}" class="menu-empty">正在加载菜品…</view>
      <view wx:elif="{{!visible.length}}" class="menu-empty">
        <text class="menu-empty__icon">✦</text>
        <text>暂时没有找到菜品</text>
        <button bindtap="resetFilters">查看全部菜品</button>
      </view>
      <view wx:for="{{visible}}" wx:key="id" class="menu-dish {{item.soldOut ? 'menu-dish--sold-out' : ''}}" data-id="{{item.id}}" bindtap="openProduct">
        <view class="menu-dish__image">
          <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" />
          <text wx:else>✦</text>
        </view>
        <view class="menu-dish__body">
          <text class="menu-dish__name">{{item.name}}</text>
          <text class="menu-dish__desc">{{item.description || '现点现做 · 新鲜美味'}}</text>
          <view class="menu-dish__bottom">
            <text class="menu-dish__price">{{item.priceText}}</text>
            <text wx:if="{{item.soldOut}}" class="menu-dish__sold-out">已售罄</text>
            <text wx:else class="menu-dish__add">＋</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="menu-cart" bindtap="openCart" aria-label="购物车">
    <image src="../../assets/home-cart.png" mode="aspectFit" />
    <view wx:if="{{cartCount > 0}}" class="menu-cart__dot"></view>
  </view>
</view>
