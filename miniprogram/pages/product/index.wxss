.product-page {
  padding-bottom: 175rpx;
}
.product-image {
  height: 450rpx;
  background: #e9e6d9;
  display: grid;
  place-items: center;
  color: #d5c3a7;
  font-size: 100rpx;
}
.product-image image {
  width: 100%;
  height: 100%;
}
.product-info {
  background: #fff;
  padding: 29rpx;
  margin-bottom: 16rpx;
}
.product-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 40rpx;
  font-weight: 700;
}
.favorite {
  font-size: 52rpx;
  font-weight: 400;
  color: #aeb7ae;
}
.favorite--on {
  color: #78b93b;
}
.product-info__price {
  display: block;
  font-size: 37rpx;
  margin: 12rpx 0;
}
.product-info__desc {
  display: block;
  color: #879589;
  font-size: 25rpx;
  line-height: 1.7;
}
.stock-label {
  display: inline-block;
  background: #f3f5ef;
  padding: 9rpx 15rpx;
  color: #738276;
  border-radius: 7rpx;
  font-size: 20rpx;
  margin-top: 18rpx;
}
.spec-group,
.quantity-row {
  background: #fff;
  padding: 27rpx 29rpx;
  margin-bottom: 16rpx;
}
.spec-group__title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  font-weight: 700;
}
.spec-group__title text:last-child {
  font-size: 21rpx;
  color: #a5afa5;
  font-weight: 400;
}
.spec-group__choices {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.spec-choice {
  border: 1rpx solid #e6ebe4;
  border-radius: 12rpx;
  padding: 18rpx 23rpx;
  display: flex;
  gap: 10rpx;
  font-size: 24rpx;
}
.spec-choice--active {
  color: var(--product-accent, #78b93b);
  background: #edf8df;
  border-color: #e9a890;
}
.quantity-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-weight: 700;
}
.stepper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.stepper text:first-child,
.stepper text:last-child {
  display: grid;
  place-items: center;
  background: #f2f4ef;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  font-size: 31rpx;
}
.bottom-bar__total .muted {
  font-size: 21rpx;
}
