<view wx:if="{{product}}" class="product-page" style="--product-accent:{{accent}}"><view class="product-image"><image wx:if="{{product.imageUrl}}" src="{{product.imageUrl}}" mode="aspectFill"/><text wx:else>✦</text></view><view class="product-info"><view class="product-title"><text>{{product.name}}</text><text class="favorite {{liked ? 'favorite--on' : ''}}" bindtap="favorite">{{liked ? '♥' : '♡'}}</text></view><text class="price product-info__price">{{total}}</text><text class="product-info__desc">{{product.description || '新鲜现做，到店自取。'}}</text><view class="stock-label">{{product.stock > 0 ? '剩余 ' + product.stock + ' 份' : '已售罄'}}</view></view><view wx:for="{{groups}}" wx:key="name" class="spec-group"><view class="spec-group__title"><text>{{item.name}}</text><text>{{item.required ? '必选' : '可选 · 再次点击可取消'}}</text></view><view class="spec-group__choices"><view wx:for="{{item.choices}}" wx:for-item="choice" wx:key="name" class="spec-choice {{choice.selected ? 'spec-choice--active' : ''}}" data-group="{{item.name}}" data-choice="{{choice.name}}" bindtap="choose"><text>{{choice.name}}</text><text wx:if="{{choice.priceText}}">{{choice.priceText}}</text></view></view></view><view class="quantity-row"><text>购买数量</text><view class="stepper"><text data-step="-1" bindtap="quantity">−</text><text>{{quantity}}</text><text data-step="1" bindtap="quantity">＋</text></view></view><view class="bottom-bar"><view class="bottom-bar__total"><text class="muted">合计</text><strong class="price">{{total}}</strong></view><button class="btn" disabled="{{product.stock < 1}}" bindtap="add">{{editKey ? '保存规格' : '加入购物车'}}</button></view></view>
