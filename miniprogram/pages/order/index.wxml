<view wx:if="{{order}}" class="page order-detail-page">
  <view class="order-status"><text class="order-status__icon">{{order.status === 'COMPLETED' ? '✓' : order.status === 'CANCELLED' ? '×' : '◷'}}</text><text class="order-status__name">{{statusLabel}}</text><text class="order-status__hint">{{order.status === 'PENDING_PAYMENT' ? '请在 15 分钟内完成支付' : order.status === 'PENDING_ACCEPTANCE' ? '店铺正在确认订单' : order.status === 'PREPARING' ? '美味正在制作中' : order.status === 'READY' ? '餐食已做好，请到店取餐' : order.status === 'REFUND_PENDING' ? '商家正在处理退款' : order.status === 'REFUNDED' ? (order.payment_method === 'balance' ? '订单金额已退回余额' : '退款已完成') : '感谢光临，期待下次见'}}</text></view>
  <view class="card order-detail-card"><view class="order-detail-card__title">菜品清单</view><view wx:for="{{items}}" wx:key="index" class="order-item"><view><text>{{item.name}} ×{{item.quantity}}</text><text>{{item.options_label || '标准规格'}}</text></view><text>{{item.priceText}}</text></view><view class="order-amount"><text>实付金额</text><text class="price">{{amountText}}</text></view></view>
  <view wx:if="{{order.status === 'PENDING_PAYMENT'}}" class="card order-detail-card">
    <view class="order-detail-card__title">选择支付方式</view>
    <view class="order-payment {{payMethod === 'wechat' ? 'order-payment--selected' : ''}}" data-method="wechat" bindtap="choosePayment"><view><strong>微信支付</strong><text>{{payment === 'unavailable' ? '商家暂未开通' : '使用微信支付'}}</text></view><text>{{payMethod === 'wechat' ? '●' : '○'}}</text></view>
    <view class="order-payment {{payMethod === 'balance' ? 'order-payment--selected' : ''}}" data-method="balance" bindtap="choosePayment"><view><strong>余额支付</strong><text>{{balanceAvailable ? '当前余额 ' + balanceText + (balanceEnough ? '' : '，余额不足') : '已发起微信支付，请继续支付或取消后重新下单'}}</text></view><text>{{payMethod === 'balance' ? '●' : '○'}}</text></view>
    <text wx:if="{{balanceAvailable && !balanceEnough}}" class="order-wallet-link" bindtap="goWallet">余额不足？前往充值 →</text>
  </view>
  <view class="card order-detail-card"><view class="order-detail-card__title">订单信息</view><view class="order-meta"><text>订单号</text><text>{{order.order_no}}</text></view><view class="order-meta"><text>下单时间</text><text>{{createdLabel}}</text></view><view wx:if="{{order.status !== 'PENDING_PAYMENT'}}" class="order-meta"><text>支付方式</text><text>{{paymentMethodLabel}}</text></view><view class="order-meta"><text>订单备注</text><text>{{order.remark || '无'}}</text></view><view class="order-meta"><text>取餐方式</text><text>到店自取</text></view><view wx:if="{{order.refund_note}}" class="order-meta"><text>退款说明</text><text>{{order.refund_note}}</text></view></view>
  <view class="order-guide">{{guide}}</view>
  <view class="bottom-bar"><button wx:if="{{order.status === 'PENDING_PAYMENT'}}" class="btn btn-ghost" bindtap="cancel">取消订单</button><button wx:if="{{order.status === 'PENDING_PAYMENT'}}" class="btn" disabled="{{busy || (payMethod === 'wechat' && payment === 'unavailable') || (payMethod === 'balance' && (!balanceEnough || !balanceAvailable))}}" bindtap="pay">立即支付</button><button wx:else class="btn" bindtap="reorder">再来一单</button></view>
</view>
