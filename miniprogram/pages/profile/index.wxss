.profile-page {
  min-height: 100vh;
  padding: 0 28rpx 130rpx;
  overflow-x: hidden;
}
.profile-hero {
  min-height: 300rpx;
  background: #244d3b;
  color: #fff;
  margin: 0 -28rpx 25rpx;
  padding: 36rpx 32rpx 42rpx;
}
.profile-hero__top {
  display: block;
  font-size: 23rpx;
  color: #b8d2bd;
}
.profile-hero__user {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: 42rpx;
  min-width: 0;
}
.profile-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 108rpx;
  width: 108rpx;
  min-width: 108rpx;
  max-width: 108rpx;
  height: 108rpx;
  min-height: 108rpx;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 50%;
  background: #d59e7a;
  color: #fff;
  line-height: 1;
  overflow: hidden;
}
.profile-avatar::after {
  border: 0;
}
.profile-avatar image {
  display: block;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  flex: none;
}
.profile-avatar text {
  font-size: 42rpx;
  font-weight: 700;
}
.profile-hero__identity {
  flex: 1;
  min-width: 0;
}
.profile-hero__identity input {
  display: block;
  width: 100%;
  height: 54rpx;
  font-size: 30rpx;
  color: #fff;
  font-weight: 700;
}
.profile-hero__placeholder {
  color: #d6e0d5;
  font-weight: 500;
}
.profile-hero__message {
  display: block;
  margin-top: 6rpx;
  color: #b8d1bc;
  font-size: 21rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.profile-order {
  margin-bottom: 19rpx;
}
.profile-wallet {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 19rpx;
  background: #f2f8e9;
}
.profile-wallet view text {
  display: block;
  color: #6c8668;
  font-size: 23rpx;
}
.profile-wallet view .profile-wallet__amount {
  margin-top: 8rpx;
  color: #275c3f;
  font-size: 39rpx;
}
.profile-wallet > text {
  flex: none;
  color: #5b9950;
  font-size: 23rpx;
}
.profile-merchant-switch {
  margin: 0 0 19rpx;
  padding: 18rpx 24rpx;
  border: 1rpx solid #b6d4ad;
  border-radius: 18rpx;
  background: #eaf5e5;
  color: #275c3f;
  font-size: 26rpx;
  font-weight: 700;
}
.profile-merchant-switch::after {
  border: 0;
}
.profile-order__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}
.profile-order__head text:first-child {
  font-size: 29rpx;
  font-weight: 700;
}
.profile-order__head text:last-child {
  font-size: 23rpx;
  color: #9ba69d;
  flex: none;
}
.profile-order__shortcuts {
  display: flex;
  justify-content: space-around;
  margin-top: 28rpx;
}
.profile-order__shortcut {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  text-align: center;
}
.profile-order__shortcut image {
  display: block;
  width: 42rpx;
  height: 42rpx;
}
.profile-order__shortcut text {
  font-size: 22rpx;
  color: #6f8072;
}
.profile-links {
  padding: 0 25rpx;
}
.profile-links__row {
  min-height: 92rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #f1f2ee;
  gap: 18rpx;
}
.profile-links__row:last-child {
  border: 0;
}
.profile-links__icon {
  display: block;
  width: 38rpx;
  height: 38rpx;
  flex: 0 0 38rpx;
}
.profile-links__label {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
}
.profile-links__trailing {
  flex: none;
  font-size: 26rpx;
  color: #a0aaa0;
}
.profile-links__detail {
  max-width: 270rpx;
  font-size: 22rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.profile-footer {
  text-align: center;
  color: #b1bab0;
  font-size: 21rpx;
  margin-top: 39rpx;
}
