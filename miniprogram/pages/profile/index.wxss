.profile-page {
  min-height: 100vh;
  padding: 0 28rpx 130rpx;
  overflow-x: hidden;
}
.profile-hero {
  margin: 0 -28rpx 24rpx;
  padding: 34rpx 32rpx 45rpx;
  border-radius: 0 0 30rpx 30rpx;
  background: linear-gradient(135deg, #214b3a, #376e4a);
  color: #fff;
}
.profile-hero__head,
.profile-hero__user {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}
.profile-hero__head view text {
  display: block;
}
.profile-hero__head view text:first-child {
  color: #b7d2ba;
  font-size: 21rpx;
}
.profile-hero__head view text:last-child {
  margin-top: 4rpx;
  font-size: 35rpx;
  font-weight: 700;
}
.profile-hero__shop {
  max-width: 250rpx;
  padding: 11rpx 17rpx;
  overflow: hidden;
  border: 1rpx solid #ffffff4d;
  border-radius: 100rpx;
  color: #d5ead2;
  font-size: 21rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.profile-hero__user {
  justify-content: flex-start;
  margin-top: 35rpx;
  min-width: 0;
}
.profile-avatar-frame {
  position: relative;
  flex: none;
  width: 108rpx;
  height: 108rpx;
  overflow: hidden;
  border: 4rpx solid #ffffff66;
  border-radius: 50%;
  background: #d59e7a;
}
.profile-avatar {
  position: absolute;
  top: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 0;
  padding: 0;
  margin: 0;
  overflow: hidden;
  border: 0;
  border-radius: 50%;
  background: transparent;
  color: #fff;
  line-height: 1;
}
.profile-avatar::after {
  border: 0;
}
.profile-avatar image {
  width: 100%;
  height: 100%;
  min-width: 100%;
  min-height: 100%;
  border-radius: 50%;
}
.profile-avatar text {
  font-size: 42rpx;
  font-weight: 700;
}
.profile-hero__identity {
  flex: 1;
  min-width: 0;
}
.profile-hero__role {
  display: block;
  color: #bee0b8;
  font-size: 20rpx;
}
.profile-hero__identity input {
  width: 100%;
  height: 50rpx;
  margin-top: 3rpx;
  color: #fff;
  font-size: 29rpx;
  font-weight: 700;
}
.profile-hero__placeholder {
  color: #d6e0d5;
  font-weight: 500;
}
.profile-hero__message {
  display: block;
  overflow: hidden;
  margin-top: 3rpx;
  color: #c0d9c3;
  font-size: 21rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.profile-merchant-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin: 0 0 18rpx;
  padding: 21rpx 25rpx;
  border: 1rpx solid #b9d8ae;
  border-radius: 19rpx;
  background: #eaf5e5;
  color: #2d633e;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.2;
  text-align: left;
}
.profile-merchant-switch::after {
  border: 0;
}
.profile-wallet,
.profile-section {
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(25, 55, 37, 0.035);
}
.profile-wallet {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 148rpx;
  margin-bottom: 18rpx;
  padding: 25rpx;
}
.profile-wallet__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 68rpx;
  height: 68rpx;
  border-radius: 18rpx;
  background: #eaf5e3;
  color: #5e9e3c;
  font-size: 37rpx;
  font-weight: 700;
}
.profile-wallet__copy {
  flex: 1;
  min-width: 0;
}
.profile-wallet__copy text {
  display: block;
}
.profile-wallet__copy text:first-child {
  color: #879789;
  font-size: 21rpx;
}
.profile-wallet__copy text:last-child {
  margin-top: 4rpx;
  color: #275c3f;
  font-size: 35rpx;
  font-weight: 700;
}
.profile-wallet__action {
  flex: none;
  color: #5e9e3c;
  font-size: 21rpx;
}
.profile-section {
  margin-bottom: 18rpx;
  padding: 25rpx;
}
.profile-section__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}
.profile-section__head text:first-child {
  color: #263b31;
  font-size: 29rpx;
  font-weight: 700;
}
.profile-section__head text:last-child {
  flex: none;
  color: #6bab43;
  font-size: 22rpx;
}
.profile-order__shortcuts {
  display: flex;
  gap: 10rpx;
  margin-top: 25rpx;
}
.profile-order__shortcut {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  gap: 9rpx;
  color: #657b69;
  font-size: 22rpx;
}
.profile-order__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 25rpx;
  background: #f2f8ec;
}
.profile-order__icon image {
  width: 43rpx;
  height: 43rpx;
}
.profile-links,
.profile-shop {
  padding-bottom: 5rpx;
}
.profile-links__row,
.profile-shop__row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 92rpx;
  border-bottom: 1rpx solid #f1f2ee;
}
.profile-links__row:last-child,
.profile-shop__row:last-child {
  border: 0;
}
.profile-links__row {
  margin-top: 8rpx;
}
.profile-links__icon,
.profile-shop__row image {
  flex: none;
  width: 38rpx;
  height: 38rpx;
}
.profile-links__label,
.profile-shop__row > text:nth-child(2) {
  flex: 1;
  min-width: 0;
  color: #34483a;
  font-size: 25rpx;
  font-weight: 600;
}
.profile-links__arrow {
  flex: none;
  color: #a0aaa0;
  font-size: 28rpx;
}
.profile-shop__row {
  padding: 18rpx 0;
}
.profile-shop__detail {
  max-width: 360rpx;
  color: #89998a;
  font-size: 21rpx;
  line-height: 1.4;
  text-align: right;
  word-break: break-all;
}
.profile-footer {
  margin-top: 34rpx;
  color: #b1bab0;
  font-size: 21rpx;
  text-align: center;
}
