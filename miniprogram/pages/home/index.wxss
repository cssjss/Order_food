.home-page {
  min-height: 100vh;
  padding: 34rpx 28rpx 150rpx;
}
.home-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 27rpx;
}
.home-head__hello,
.home-head__name {
  display: block;
}
.home-head__hello {
  font-size: 22rpx;
  color: #919e93;
  margin-bottom: 6rpx;
}
.home-head__name {
  font-size: 40rpx;
  font-weight: 700;
}
.home-head__badge {
  flex: none;
  font-size: 21rpx;
  color: #5c9b35;
  background: #e9f7db;
  border-radius: 100rpx;
  padding: 12rpx 20rpx;
}
.home-hero {
  min-height: 322rpx;
  background: linear-gradient(125deg, #e7f6aa 0%, #b9df6f 58%, #8fc95c 100%);
  background-size: cover;
  background-position: center;
  border-radius: 29rpx;
  padding: 48rpx 39rpx;
  color: #265531;
  display: flex;
  flex-direction: column;
}
.home-hero--image {
  color: #fff;
}
.home-hero__subtitle {
  font-size: 23rpx;
  letter-spacing: 3rpx;
  color: #52833b;
}
.home-hero--image .home-hero__subtitle {
  color: #f2e4ce;
}
.home-hero__title {
  font-size: 47rpx;
  font-weight: 700;
  line-height: 1.25;
  max-width: 460rpx;
  margin: 22rpx 0;
}
.home-hero__action {
  align-self: flex-start;
  border-radius: 100rpx;
  padding: 12rpx 22rpx;
  background: var(--home-accent, #78b93b);
  color: #fff;
  font-size: 22rpx;
}
.home-store {
  display: flex;
  gap: 18rpx;
  margin: 23rpx 0;
  color: #7c8c7f;
  font-size: 21rpx;
}
.home-store text {
  max-width: 50%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.home-notice {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 22rpx;
  background: #eff8e5;
  border-radius: 15rpx;
  color: #56843e;
  font-size: 22rpx;
}
.home-notice text:first-child {
  flex: none;
  font-weight: 700;
}
.home-notice text:last-child {
  min-width: 0;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
}
.home-recommend {
  margin-top: 40rpx;
}
.home-recommend__head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.home-recommend__eyebrow,
.home-recommend__title {
  display: block;
}
.home-recommend__eyebrow {
  color: #94a295;
  font-size: 21rpx;
  margin-bottom: 4rpx;
}
.home-recommend__title {
  font-size: 36rpx;
  font-weight: 700;
}
.home-recommend__more {
  flex: none;
  color: #5e9e3c;
  font-size: 23rpx;
  padding: 10rpx 0;
}
.home-recommend__grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}
.home-dish {
  min-width: 0;
  overflow: hidden;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(25, 55, 37, 0.035);
}
.home-dish__image {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 220rpx;
  background: #e8efde;
  color: #a9c994;
  font-size: 54rpx;
}
.home-dish__image image {
  width: 100%;
  height: 100%;
}
.home-dish__body {
  padding: 17rpx 18rpx 20rpx;
}
.home-dish__name,
.home-dish__desc,
.home-dish__price {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.home-dish__name {
  color: #263b31;
  font-size: 27rpx;
  font-weight: 700;
}
.home-dish__desc {
  margin-top: 7rpx;
  color: #9aa69c;
  font-size: 20rpx;
}
.home-dish__price {
  margin-top: 13rpx;
  color: #6caf38;
  font-size: 27rpx;
  font-weight: 700;
}
.home-recommend__empty,
.home-recommend__loading {
  border-radius: 22rpx;
  background: #fff;
  text-align: center;
  color: #91a092;
}
.home-recommend__empty {
  padding: 52rpx 20rpx;
}
.home-recommend__empty text {
  display: block;
  font-size: 22rpx;
  margin-top: 6rpx;
}
.home-recommend__empty text:first-child {
  color: #a6c88f;
  font-size: 56rpx;
  margin: 0 0 10rpx;
}
.home-recommend__empty text:nth-child(2) {
  color: #506a53;
  font-size: 27rpx;
  font-weight: 700;
}
.home-recommend__empty button {
  display: inline-block;
  margin-top: 26rpx;
  border-radius: 100rpx;
  background: var(--home-accent, #78b93b);
  color: #fff;
  font-size: 24rpx;
  line-height: 1.2;
  padding: 16rpx 38rpx;
}
.home-recommend__empty button::after {
  border: 0;
}
.home-recommend__loading {
  padding: 50rpx 20rpx;
  font-size: 23rpx;
}
.home-menu-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 28rpx;
  padding: 28rpx 30rpx;
  border-radius: 20rpx;
  background: #eaf5e3;
  color: #315c3f;
}
.home-menu-link view {
  min-width: 0;
}
.home-menu-link view text {
  display: block;
}
.home-menu-link view text:first-child {
  font-size: 27rpx;
  font-weight: 700;
}
.home-menu-link view text:last-child {
  margin-top: 6rpx;
  color: #739479;
  font-size: 21rpx;
}
.home-menu-link__arrow {
  flex: none;
  font-size: 34rpx;
}
