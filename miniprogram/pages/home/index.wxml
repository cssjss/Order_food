<view class="home-page" style="--home-accent:{{page.accent || '#78b93b'}}">
  <view class="home-head">
    <view>
      <text class="home-head__hello">欢迎光临 · 到店自取</text>
      <text class="home-head__name">{{shop.name}}</text>
    </view>
    <text class="home-head__badge">现做 · 好味</text>
  </view>

  <view class="home-hero {{page.heroImage ? 'home-hero--image' : ''}}" style="background-image:{{page.heroImage ? 'linear-gradient(90deg,rgba(19,54,37,.66),rgba(19,54,37,.1)),url(' + imageBase + page.heroImage + ')' : ''}}" bindtap="goMenu">
    <text class="home-hero__subtitle">{{page.heroSubtitle}}</text>
    <text class="home-hero__title">{{page.heroTitle}}</text>
    <text class="home-hero__action">开始点餐 →</text>
  </view>

  <view class="home-store">
    <text>◷ {{shop.hours}}</text>
    <text>⌖ {{shop.pickupAddress || '到店自取'}}</text>
  </view>
  <view wx:if="{{page.showNotice && shop.notice}}" class="home-notice">
    <text>店铺公告</text>
    <text>{{shop.notice}}</text>
  </view>

  <view class="home-recommend">
    <view class="home-recommend__head">
      <view>
        <text class="home-recommend__eyebrow">为你挑选</text>
        <text class="home-recommend__title">{{page.featuredTitle || '今日推荐'}}</text>
      </view>
      <text class="home-recommend__more" bindtap="goMenu">全部菜品 →</text>
    </view>

    <view wx:if="{{page.showFeatured && featured.length}}" class="home-recommend__grid">
      <view wx:for="{{featured}}" wx:key="id" class="home-dish" data-id="{{item.id}}" bindtap="openProduct">
        <view class="home-dish__image">
          <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" />
          <text wx:else>✦</text>
        </view>
        <view class="home-dish__body">
          <text class="home-dish__name">{{item.name}}</text>
          <text class="home-dish__desc">{{item.description || '现点现做 · 新鲜美味'}}</text>
          <text class="home-dish__price">{{item.priceText}}</text>
        </view>
      </view>
    </view>
    <view wx:elif="{{!loading}}" class="home-recommend__empty">
      <text>✦</text>
      <text>推荐菜品正在准备中</text>
      <text>更多好味可以在点餐页查看</text>
      <button bindtap="goMenu">去点餐</button>
    </view>
    <view wx:else class="home-recommend__loading">正在加载推荐菜品…</view>
  </view>

  <view class="home-menu-link" bindtap="goMenu">
    <view><text>想看看更多？</text><text>进入点餐页，按分类挑选喜欢的餐品</text></view>
    <text class="home-menu-link__arrow">→</text>
  </view>
</view>
