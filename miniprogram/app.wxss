page {
  background: #f8fbf4;
  color: #263b31;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}
view,
text,
button,
input,
textarea,
image {
  box-sizing: border-box;
}
.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 150rpx;
}
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 26rpx;
  box-shadow: 0 10rpx 28rpx rgba(25, 55, 37, 0.035);
}
.muted {
  color: #929d94;
}
.accent {
  color: #78b93b;
}
.price {
  color: #78b93b;
  font-weight: 700;
}
.btn {
  border: 0;
  border-radius: 16rpx;
  background: #78b93b;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.2;
  padding: 25rpx 34rpx;
}
.btn:after {
  border: 0;
}
.btn[disabled] {
  background: #d8dcd6;
  color: #fff;
}
.btn-ghost {
  background: #fff;
  color: #42584a;
  border: 1rpx solid #e5e9e3;
}
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 36rpx 0 20rpx;
}
.section-head text:first-child {
  font-size: 35rpx;
  font-weight: 700;
}
.empty {
  padding: 100rpx 25rpx;
  text-align: center;
  color: #9ba59c;
}
.empty .empty-icon {
  display: block;
  font-size: 82rpx;
  margin-bottom: 20rpx;
  color: #cfdbd0;
}
.field-label {
  font-size: 25rpx;
  color: #738177;
  margin-bottom: 14rpx;
  display: block;
}
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 25rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  gap: 20rpx;
  z-index: 5;
}
.bottom-bar .btn {
  flex: 1;
}
.bottom-bar__total {
  min-width: 220rpx;
}
.bottom-bar__total strong {
  display: block;
  font-size: 36rpx;
}
.tag {
  display: inline-block;
  padding: 8rpx 15rpx;
  background: #edf8df;
  color: #78b93b;
  border-radius: 100rpx;
  font-size: 21rpx;
}
